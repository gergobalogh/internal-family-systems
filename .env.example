# Server-side only: read by server/ai.ts, never sent to the browser.
# Missing keys are fine — the conversation falls back gracefully.
ANTHROPIC_API_KEY=
# Muse Spark (Meta's Model API): when set, it writes the reflections, names
# and phrases instead of Claude
META_API_KEY=
JEV_API_KEY=
# Optional: a gateway in front of JEV (defaults to https://api.typesafe.ai)
JEV_BASE_URL=
# The risk check: OpenAI moderation, side by side with JEV
OPENAI_API_KEY=
